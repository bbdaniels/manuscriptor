{#-
  The viewer.

  It takes ONE variable, `ms`: a plain dict matching the data contract, which
  is embedded verbatim as `window.MS`. Everything the page knows arrives that
  way, so there is exactly one thing to keep in sync between the server and
  the client.

      ms = {
        "title": str,
        "html": str,           # rendered manuscript, every block carrying data-mx
        "blocks": {id: {id,kind,file,line_start,line_end,source,editable,
                        parent_heading,includes,cites,values}},
        "outline": [{level,text,id}],
        "chats":   {block_id: [{id,who,body,ts,state}]},
        "queue":   [{id,block,section,body,state,since,waited}],  # oldest first
        "ticker":  [{kind,id,state,block,section,when}],          # newest first
        "todos":   [{text,done}],
        "activity":[{text,when}],
        "stats":   {files,cites,values,exhibits},
      }

  `queue` and `ticker` are the agent's standing state, seeded here so a page
  opened while a session is mid-run does not paint "idle" and then correct
  itself. Both are kept current afterwards by the `queue`, `state` and `patch`
  frames rather than by a reload.

  `styles_css` and `viewer_js` are the two static files, inlined so the page
  is a single self-contained artefact that can be opened straight off disk.

  The manuscript html is written into the document server-side rather than
  injected by script: it is what makes the page readable before anything runs,
  and it is what carries the `data-mx` anchors into real markup where the
  margin can address them.

  The fallback below keeps the older `title` + `manuscript_html` call shape
  (manuscriptor/evidence/render.py, the static export) rendering a readable
  page instead of raising. It degrades to an empty inspector, which is honest:
  that call has no block map to inspect.
-#}
{%- set MS = ms if ms is defined and ms else {
  'title': title | default('Manuscript', true),
  'html': manuscript_html | default('', true),
  'blocks': {}, 'outline': [], 'chats': {}, 'queue': [], 'ticker': [],
  'todos': [], 'activity': [], 'stats': {}
} -%}
{%- set stats = MS.get('stats', {}) or {} -%}
{%- set todos = MS.get('todos', []) or [] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ MS.get('title', 'Manuscript') }} — manuscriptor</title>
  <style>{{ styles_css | default('', true) | safe }}</style>
</head>
<body>
<div class="app" data-skin="instrument" id="app">

  <div class="titlebar">
    <div class="dots"><i></i><i></i><i></i></div>
    <span class="name">Manuscriptor</span>
    <span class="path" id="doc-path">{{ MS.get('path', '') }}</span>
    {#- The standing agent state. "3 queued · 1 working", "idle" when there is
        nothing. It sits beside the socket's own pulse because they answer two
        different questions: is the page live, and is anything being done to the
        manuscript. -#}
    <span class="agent is-idle" id="agent-status" title="Nothing queued."><span class="adot"></span><span class="atext">idle</span></span>
    <span class="live" id="live"><span class="pulse"></span> <span id="live-text">watching</span></span>
  </div>

  <div class="toolbar">
    <span class="grp">
      <button class="tb" type="button" data-act="compile:pdf">Compile PDF</button>
      <button class="tb" type="button" data-act="compile:docx">Compile Word</button>
    </span>
    <span class="sep"></span>
    <span class="grp">
      <button class="tb accent" type="button" data-open="import:reviewer">Read in comments…</button>
    </span>
    <span class="skinctl">
      <button class="tb" type="button" data-skin="instrument" aria-pressed="true">Instrument</button>
      <button class="tb" type="button" data-skin="glass" aria-pressed="false">Glass</button>
      <span class="hues"><input type="color" class="wheel" id="hue-wheel" value="#5597DB" aria-label="space colour"></span>
    </span>
    <span class="tb-meta" id="toolbar-meta"></span>
  </div>

  {#- What actually happened, newest first, filled in by the viewer from the
      log's state records and the patch frames. Hidden until there is something
      to say, so an idle manuscript loses no reading height to it. -#}
  <div class="ticker" id="ticker" aria-live="polite" hidden></div>

  <div class="cols">

    <!-- ================= rail ================= -->
    <nav class="rail" id="rail">
      <div>
        <h3>Manuscript</h3>
        <div class="outline" id="outline">
          {%- set ns = namespace(top='') -%}
          {%- for h in MS.get('outline', []) %}
          {%- if h.get('level', 1) == 1 %}
          {%- set ns.top = h.get('id', '') %}
          <div class="sec">
            <button class="twist" type="button" data-twist="{{ ns.top }}" aria-expanded="false"
                    aria-label="Expand this section"><svg viewBox="0 0 8 8" aria-hidden="true"><path d="M1 2.5 L4 5.5 L7 2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <a data-goto="{{ h.get('id', '') }}" class="lvl1" tabindex="0">{{ h.get('text', '') }}</a>
          </div>
          {%- else %}
          <a data-goto="{{ h.get('id', '') }}" data-under="{{ ns.top }}" class="lvl{{ h.get('level', 1) }} is-hidden" tabindex="0">{{ h.get('text', '') }}</a>
          {%- endif %}
          {%- endfor %}
        </div>
      </div>

      <div>
        <h3>Sources</h3>
        <div class="outline">
          <a>{{ stats.get('files', 0) }} tex files</a>
          <a>{{ stats.get('cites', 0) }} citations</a>
          <a>{{ stats.get('values', 0) }} computed values</a>
          <a>{{ stats.get('exhibits', 0) }} exhibits</a>
        </div>
      </div>

      <div>
        <h3>To do <span class="n">{{ todos | selectattr('done') | list | length }} of {{ todos | length }}</span></h3>
        <div class="todo" id="todos">
          {%- for t in todos %}
          <label><input type="checkbox"{% if t.get('done') %} checked{% endif %}> {% if t.get('done') %}<s>{{ t.get('text', '') }}</s>{% else %}{{ t.get('text', '') }}{% endif %}</label>
          {%- endfor %}
        </div>
      </div>

      <div>
        <h3>Activity</h3>
        <div class="feed" id="activity">
          {%- for e in MS.get('activity', []) %}
          <div class="ev{% if loop.first %} now{% endif %}">{{ e.get('text', '') }}<time>{{ e.get('when', '') }}</time></div>
          {%- endfor %}
        </div>
      </div>
    </nav>

    <!-- ================= manuscript ================= -->
    <main class="doc" id="doc">
      <div class="doc-inner" id="doc-inner">{{ MS.get('html', '') | safe }}</div>
    </main>

    <!-- ================= inspector ================= -->
    <aside class="insp" id="insp">
      <div class="insp-head">
        <button class="back" id="back" type="button" hidden></button>
        <div class="eyebrow" id="eyebrow">Nothing open</div>
        <h4 id="ititle">{{ MS.get('title', 'Manuscript') }}</h4>
        <div class="sub" id="isub"></div>
        <div id="headsave"></div>
        <button class="jump" id="jump" type="button" hidden>↑ back to the paragraph this belongs to</button>
      </div>
      <div class="tabs" id="tabs"></div>
      <div class="insp-body" id="ibody">
        <p class="empty">Click a paragraph to see its source and its chat, a citation to see its
        evidence, or a violet number to see the code that produced it.</p>
      </div>
    </aside>

  </div>
</div>

<script id="ms-data">
window.MS = {{ MS | tojson }};
</script>
<script>{{ viewer_js | default('', true) | safe }}</script>
{%- for name, code in (extensions | default({}, true)).items() %}
<script data-ext="{{ name }}">{{ code | safe }}</script>
{%- endfor %}
</body>
</html>
